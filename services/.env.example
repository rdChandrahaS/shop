# Local development secrets. Copy to .env and replace placeholder values.
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Must be at least 32 bytes for HMAC-SHA256. Keep the same value in authservice and apigateway.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GATEWAY_INTERNAL_SECRET=replace-with-another-random-internal-secret

RAZORPAY_API_KEY=rzp_test_replace_me
RAZORPAY_API_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
